rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return true;
    }
    
    function isValidId(id) {
      return id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() > 0 && id.size() <= 64;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(projectId) && isValidProject(request.resource.data);
      allow update: if isAuthenticated() && isValidId(projectId) && isValidProject(request.resource.data);
      allow delete: if isAuthenticated() && isValidId(projectId);
    }
    
    match /skills/{skillId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(skillId) && isValidSkill(request.resource.data);
      allow update: if isAuthenticated() && isValidId(skillId) && isValidSkill(request.resource.data);
      allow delete: if isAuthenticated() && isValidId(skillId);
    }
    
    match /profile/{profileId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidId(profileId) && isValidProfile(request.resource.data);
      allow update: if isAuthenticated() && isValidId(profileId) && isValidProfile(request.resource.data);
      allow delete: if isAuthenticated() && isValidId(profileId);
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title'])
             && data.title is string
             && data.title.size() <= 256;
    }
    
    function isValidSkill(data) {
      return data.keys().hasAll(['name'])
             && data.name is string
             && data.name.size() <= 256;
    }
    
    function isValidProfile(data) {
      return data.keys().hasAll(['name'])
             && data.name is string
             && data.name.size() <= 256;
    }
  }
}
